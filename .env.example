# --- Copy to .env and change secrets for anything non-local ---
#   cp .env.example .env

# ============ Postgres (auth) ============
POSTGRES_AUTH_DB=apilens_auth
POSTGRES_AUTH_USER=apilens
POSTGRES_AUTH_PASSWORD=apilens_dev

# ============ Postgres (files) ============
POSTGRES_FILES_DB=apilens_files
POSTGRES_FILES_USER=apilens
POSTGRES_FILES_PASSWORD=apilens_dev

# ============ Postgres (preferences) ============
POSTGRES_PREFS_DB=apilens_prefs
POSTGRES_PREFS_USER=apilens
POSTGRES_PREFS_PASSWORD=apilens_dev

# ============ JWT ============
# Generate a strong secret:  openssl rand -base64 64
JWT_SECRET=CHANGE_ME_dev_only_secret_at_least_64_chars_long_0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ============ MinIO (S3-compatible) ============
MINIO_ROOT_USER=apilens
MINIO_ROOT_PASSWORD=apilens_dev_minio
MINIO_BUCKET=apilens-files
MINIO_ENDPOINT=http://localhost:9000

# ============ RabbitMQ ============
RABBITMQ_DEFAULT_USER=apilens
RABBITMQ_DEFAULT_PASS=apilens_dev
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ Load testing ============
# Any request with header  X-Load-Test-Key: <this value>
# bypasses rate limiting. Only use against loadtest stack.
LOAD_TEST_KEY=loadtest_dev_bypass_key

# ============ Frontend ============
VITE_API_BASE_URL=/api
